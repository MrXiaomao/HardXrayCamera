/* QLineEdit基础样式 */
QLineEdit{
  color:palette(text); /* 文字颜色使用系统文本色 */
}

/* 空文本状态下的QLineEdit样式 */
QLineEdit[text=""]{ 
  color:palette(text); /* 空文本时文字颜色仍使用系统文本色 */
}

/* 行文本编辑框只读属性样式 */
QLineEdit:read-only{
  background:palette(window); /* 背景使用系统窗口色 */
}

/* 行文本编辑框禁用属性样式 */
QLineEdit:disabled{
  background:palette(base); /* 背景使用系统基础色 */
}

/* 多行富文本编辑框基础样式 */
QTextEdit{
  color:palette(text); /* 文本颜色：系统文本色 */
  border:0px solid palette(highlight); /* 边框：0px系统高亮色实线 */
  border-radius:0px; /* 边框无圆角（直角） */
}

/* 多行富文本编辑框只读属性样式 */
QTextEdit:read-only{
  background:palette(window); /* 背景使用系统窗口色 */
}

/* 多行富文本编辑框禁用属性样式 */
QTextEdit:disabled{
  background:palette(base); /* 背景使用系统基础色 */
}

/* 空文本状态下的QTextEdit样式 */
QTextEdit[text=""]{ 
  color:palette(text); /* 空文本时文字颜色仍使用系统文本色 */
  border:0px solid palette(highlight); /* 保持边框样式不变 */
  border-radius:0px; /* 保持直角边框 */
}

/* QPlainTextEdit基础样式 */
QPlainTextEdit{
  color:palette(text); /* 文字颜色使用系统文本色 */
}

/* 空文本状态下的QPlainTextEdit样式 */
QPlainTextEdit[text=""]{ 
  color:palette(text); /* 空文本时文字颜色仍使用系统文本色 */
}

/* 工具提示（QToolTip）样式 */
QToolTip{
  color:palette(text); /* 文字颜色使用系统文本色 */
  background-color:palette(base); /* 背景色使用系统基础色 */
  border:1px solid palette(highlight); /* 边框：1px系统高亮色实线 */
  border-radius:0px; /* 边框无圆角 */
}

/* 状态栏（QStatusBar）样式 */
QStatusBar{
  background-color:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 背景：垂直渐变浅灰（上浅下稍深） */
  color:palette(text); /* 文字颜色使用系统文本色 */
}

/* 状态栏子项中的QLabel样式 */
QStatusBar::item QLabel {
  font-size: 12px; /* 字体大小设为12px */
}

/* 菜单栏（QMenuBar）基础样式 */
QMenuBar{
  background-color:transparent; /* 背景透明 */
  spacing:0px; /* 菜单项之间的间距设为0px */
}

/* 菜单栏项（QMenuBar::item）基础样式 */
QMenuBar::item{
  spacing:2px; /* 菜单项内部元素间距设为2px */
  padding:0px 4px; /* 内边距：上下0px，左右4px */
  background:transparent; /* 背景透明 */
}

/* 菜单栏项选中状态 */
QMenuBar::item:selected{
  background-color:rgba(220,220,220,255); /* 背景色：浅灰色不透明 */
}

/* 工具按钮（QToolButton）悬停状态 */
QToolButton:hover{
  background-color:rgba(220,220,220,255); /* 悬停时背景色：浅灰色不透明 */
}

/* 菜单栏项按下状态样式 */
QMenuBar::item:pressed{
  background-color:palette(highlight); /* 背景色使用系统高亮色 */
  color:rgba(255,255,255,255); /* 文字颜色为纯白色 */
  border-left:1px solid rgba(200,200,200,127); /* 左侧边框：1px浅灰色半透明 */
  border-right:1px solid rgba(200,200,200,127); /* 右侧边框：同上 */
}

/* 菜单整体样式 */
QMenu{
  background-color:palette(window); /* 背景色使用系统窗口色 */
  border:1px solid palette(shadow); /* 边框使用系统阴影色 */
}

/* 菜单项基础样式 */
QMenu::item{
  padding:3px 15px 3px 15px; /* 内边距：上下3px，左右15px */
  border:1px solid transparent; /* 透明边框，为选中状态预留空间 */
}

/* 菜单项禁用状态 */
QMenu::item:disabled{
  background-color:rgba(235,235,235,127); /* 背景色：极浅灰色半透明 */
  color:palette(disabled); /* 文字颜色使用系统禁用色 */
}

/* 菜单项选中状态 */
QMenu::item:selected{
  border-color:rgba(147,191,236,127); /* 边框颜色：浅蓝色半透明 */
  background:palette(highlight); /* 背景色使用系统高亮色 */
  color:rgba(255,255,255,255); /* 文字颜色为纯白色 */
}

/* 菜单项图标左边距 */
QMenu::icon {
  padding-left: 10px; /* 图标左内边距设为10px */
}

/* 选中状态的菜单项图标样式 */
QMenu::icon:checked{
  background-color:qlineargradient(x1:0,y1:1,x2:0,y2:0,stop:0 rgba(230,230,230,127),stop:1 rgba(240,240,240,75)); /* 背景：从上到下的渐变浅灰 */
  border:1px solid palette(highlight); /* 边框使用系统高亮色 */
  border-radius:2px; /* 圆角：2px */
}

/* 菜单分隔线样式 */
QMenu::separator{
  height:1px; /* 高度：1px */
  background:palette(alternate-base); /* 背景色使用系统交替基础色 */
  margin-left:2px; /* 左外边距：2px */
  margin-right:2px; /* 右外边距：2px */
}

/* 菜单项指示器（如复选框、单选框）基础样式 */
QMenu::indicator{
  width:15px; /* 宽度：15px */
  height:15px; /* 高度：15px */
}

/* 非排他性指示器（复选框）选中状态 */
QMenu::indicator:non-exclusive:checked{
  padding-left:2px; /* 左内边距：2px（用于调整位置） */
}

/* 非排他性指示器（复选框）未选中状态 */
QMenu::indicator:non-exclusive:unchecked{
  padding-left:2px; /* 同上 */
}

/* 排他性指示器（单选框）选中状态 */
QMenu::indicator:exclusive:checked{
  padding-left:2px; /* 同上 */
}

/* 排他性指示器（单选框）未选中状态 */
QMenu::indicator:exclusive:unchecked{
  padding-left:2px; /* 同上 */
}

/* 顶部工具栏样式 */
QToolBar::top{
  background-color:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 背景：垂直渐变浅灰（上浅下深） */
  border-bottom:3px solid qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 底部边框：3px渐变浅灰 */
}

/* 底部工具栏样式 */
QToolBar::bottom{
  background-color:qlineargradient(x1:0,y1:1,x2:0,y2:0,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 背景：垂直渐变浅灰（下浅上深） */
  border-top:3px solid qlineargradient(x1:0,y1:1,x2:0,y2:0,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 顶部边框：3px渐变浅灰 */
}

/* 左侧工具栏样式 */
QToolBar::left{
  background-color:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 背景：水平渐变浅灰（左浅右深） */
  border-right:3px solid qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 右侧边框：3px渐变浅灰 */
}

/* 右侧工具栏样式 */
QToolBar::right{
  background-color:qlineargradient(x1:1,y1:0,x2:0,y2:0,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 背景：水平渐变浅灰（右浅左深） */
  border-left:3px solid qlineargradient(x1:1,y1:0,x2:0,y2:0,stop:0 rgba(230,230,230,255),stop:1 rgba(245,245,245,255)); /* 左侧边框：3px渐变浅灰 */
}

/* 主窗口分隔器样式 */
QMainWindow::separator{
  width:6px; /* 水平分隔器宽度 */
  height:5px; /* 垂直分隔器高度 */
  padding:2px; /* 内边距：2px */
}

/* 组合框基础样式 */
QComboBox {
  combobox-popup: 0; /* 禁用默认下拉弹窗样式（使用自定义视图） */
}

/* 组合框下拉列表视图样式 */
QComboBox QAbstractItemView {
  border: 1px solid palette(shadow); /* 边框：1px系统阴影色实线 */
}

/* 组合框列表项选中状态 */
QComboBox:item:selected {
  border: none; /* 无选中边框 */
  background:palette(highlight); /* 背景色：系统高亮色 */
  color:rgba(255,255,255,255); /* 文字颜色：白色 */
}

/* 组合框指示器样式 */
QComboBox::indicator{
  background-color:transparent; /* 背景透明 */
  selection-background-color:transparent; /* 选中时背景透明 */
  color:transparent; /* 文字透明 */
  selection-color:transparent; /* 选中时文字透明 */
}

/* 水平分割器手柄样式 */
QSplitter::handle:horizontal{
  background:palette(base); /* 背景色：系统基础色 */
  width:10px; /* 手柄宽度 */
}

/* 垂直分割器手柄样式 */
QSplitter::handle:vertical{
  background:palette(base); /* 背景色：系统基础色 */
  height:10px; /* 手柄高度 */
}

/* 分隔器和分割器手柄悬停状态 */
QMainWindow::separator:hover,QSplitter::handle:hover{
  background:palette(highlight); /* 悬停时背景色：系统高亮色 */
}

/* 停靠窗口标题栏样式 */
QDockWidget::title{
  padding:4px; /* 内边距：4px */
  background-color:qlineargradient(x1:0,y1:1,x2:0,y2:0,stop:0 rgba(230,230,230,127),stop:1 rgba(245,245,245,75)); /* 背景：垂直渐变浅灰（下浅上深） */
  border:1px solid rgba(200,200,200,75); /* 边框：1px半透明浅灰色 */
  border-bottom:2px solid rgba(200,200,200,75); /* 底部边框：2px半透明浅灰色 */
}

/* 停靠窗口基础样式 */
QDockWidget{
  /* 如果使用浅色图标，请将路径中的dark替换为light，若没有对应图标保持原样即可 */
  titlebar-close-icon:url(":/qss_icons/light/light_icons/window_close.png");
  titlebar-normal-icon:url(":/qss_icons/light/light_icons/window_undock.png");
}

/* 停靠窗口关闭和浮动按钮位置 */
QDockWidget::close-button,QDockWidget::float-button{
  subcontrol-position:top right; /* 子控件位置：右上角 */
  subcontrol-origin:margin; /* 子控件原点：边距 */
  position:absolute; /* 绝对定位 */
  top:3px; /* 顶部距离 */
  bottom:0px; /* 底部距离 */
  width:20px; /* 宽度 */
  height:20px; /* 高度 */
}

/* 关闭按钮位置 */
QDockWidget::close-button{
  right:3px; /* 右侧距离 */
}

/* 浮动按钮位置 */
QDockWidget::float-button{
  right:25px; /* 右侧距离（关闭按钮左侧22px） */
}

/* 分组框基础样式 */
QGroupBox{
  background-color:rgba(245,245,245,50%); /* 背景：半透明极浅灰色 */
  margin-top:27px; /* 顶部外边距：27px（为标题预留空间） */
  border:1px solid rgba(200,200,200,127); /* 边框：1px半透明浅灰色 */
  border-radius:4px; /* 圆角：4px */
}

/* 分组框标题样式 */
QGroupBox::title{
  subcontrol-origin:margin; /* 子控件原点：边距 */
  subcontrol-position:left top; /* 子控件位置：左上角 */
  padding:4px 6px; /* 内边距：上下4px，左右6px */
  margin-left:3px; /* 左侧外边距：3px */
  background-color:qlineargradient(x1:0,y1:1,x2:0,y2:0,stop:0 rgba(230,230,230,127),stop:1 rgba(245,245,245,75)); /* 背景：垂直渐变浅灰（下浅上深） */
  border:1px solid rgba(200,200,200,75); /* 边框：1px半透明浅灰色 */
  border-bottom:2px solid rgb(180,180,180); /* 底部边框：2px中浅灰色 */
  border-top-left-radius:4px; /* 左上角圆角：4px */
  border-top-right-radius:4px; /* 右上角圆角：4px */
}

/* 标签页容器样式 */
QTabWidget::pane{
  background-color:palette(base); /* 背景色：系统基础色 */
  border-top:1px solid rgba(200,200,200,50%); /* 顶部边框：1px半透明浅灰色 */
}

/* 标签栏布局 */
QTabWidget::tab-bar{
  alignment: left; /* 对齐方式：左对齐 */
  left:3px; /* 左侧距离：3px */
  top:1px; /* 顶部距离：1px */
}

/* 标签栏基础样式 */
QTabBar{
  background-color:transparent; /* 背景透明 */
  qproperty-drawBase:0; /* 禁用默认背景绘制 */
  border-bottom:1px solid rgba(200,200,200,127); /* 底部边框：1px半透明浅灰色 */
}

/* 标签页基础样式 */
QTabBar::tab{
  background-color:qlineargradient(x1:0,y1:1,x2:0,y2:0,stop:0 rgba(230,230,230,127),stop:1 rgba(245,245,245,75)); /* 背景：垂直渐变浅灰（下浅上深） */
  border:1px solid rgba(200,200,200,75); /* 边框：1px半透明浅灰色 */
  border-bottom:2px solid rgb(180,180,180); /* 底部边框：2px中浅灰色 */
  border-top-left-radius:4px; /* 左上角圆角：4px */
  border-top-right-radius:4px; /* 右上角圆角：4px */
  padding:4px 6px; /* 内边距：上下4px，左右6px */
  min-width:40px; /* 标签最小宽度：40px */
  margin-right:2px; /* 右侧外边距：2px */
}

/* 选中标签页样式 */
QTabBar::tab:selected{
  border-bottom: 2px solid palette(highlight); /* 底部边框：2px系统高亮色 */
}

/* 滚动条基础样式（垂直） */
QScrollBar:vertical{
  width:12px; /* 滚动条宽度：12px */
  background:palette(window); /* 背景色：系统窗口色 */
  margin:0px; /* 外边距：0px */
}

/* 滚动条滑块（垂直） */
QScrollBar::handle:vertical{
  background:rgba(200,200,200,200); /* 背景：半透浅灰色 */
  min-height:30px; /* 滑块最小高度：30px */
  border-radius:4px; /* 圆角：4px */
}

/* 滚动条滑块悬停（垂直） */
QScrollBar::handle:vertical:hover{
  background:rgba(180,180,180,220); /* 背景：加深的半透浅灰色 */
}

/* 滚动条上下箭头（垂直） */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical{
  height:0px; /* 箭头高度设为0，隐藏默认箭头 */
  width:0px;
}

/* 滚动条基础样式（水平） */
QScrollBar:horizontal{
  height:12px; /* 滚动条高度：12px */
  background:palette(window); /* 背景色：系统窗口色 */
  margin:0px; /* 外边距：0px */
}

/* 滚动条滑块（水平） */
QScrollBar::handle:horizontal{
  background:rgba(200,200,200,200); /* 背景：半透浅灰色 */
  min-width:30px; /* 滑块最小宽度：30px */
  border-radius:4px; /* 圆角：4px */
}

/* 滚动条滑块悬停（水平） */
QScrollBar::handle:horizontal:hover{
  background:rgba(180,180,180,220); /* 背景：加深的半透浅灰色 */
}

/* 滚动条左右箭头（水平） */
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal{
  height:0px; /* 箭头大小设为0，隐藏默认箭头 */
  width:0px;
}

/* 按钮基础样式 */
QPushButton{
  background-color:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(245,245,245,255),stop:1 rgba(220,220,220,255)); /* 背景：垂直渐变浅灰（上浅下深） */
  border:1px solid rgba(180,180,180,200); /* 边框：1px半透浅灰色 */
  border-radius:4px; /* 圆角：4px */
  padding:4px 10px; /* 内边距：上下4px，左右10px */
}

/* 按钮悬停样式 */
QPushButton:hover{
  background-color:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(250,250,250,255),stop:1 rgba(230,230,230,255)); /* 背景：整体变亮的渐变 */
  border:1px solid palette(highlight); /* 边框改为系统高亮色 */
}

/* 按钮按下样式 */
QPushButton:pressed{
  background-color:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(220,220,220,255),stop:1 rgba(240,240,240,255)); /* 背景：反转渐变方向 */
}

/* 勾选框指示器基础样式 */
QCheckBox::indicator{
  width:16px; /* 指示器宽度：16px */
  height:16px; /* 指示器高度：16px */
  border:1px solid rgba(180,180,180,200); /* 边框：1px半透浅灰色 */
  border-radius:2px; /* 圆角：2px */
  background-color:palette(base); /* 背景色：系统基础色 */
}

/* 勾选框选中指示器 */
QCheckBox::indicator:checked{
  background-color:palette(highlight); /* 背景：系统高亮色 */
  image:url(:/qss_icons/light/light_icons/check.png); /* 勾选图标使用浅色版 */
}

/* 单选框指示器基础样式 */
QRadioButton::indicator{
  width:16px; /* 指示器宽度：16px */
  height:16px; /* 指示器高度：16px */
  border:1px solid rgba(180,180,180,200); /* 边框：1px半透浅灰色 */
  border-radius:8px; /* 全圆角实现圆形 */
  background-color:palette(base); /* 背景色：系统基础色 */
}

/* 单选框选中指示器 */
QRadioButton::indicator:checked{
  background-color:palette(highlight); /* 背景：系统高亮色 */
}

/* 滑动条凹槽基础样式 */
QSlider::groove:horizontal{
  border:1px solid rgba(180,180,180,200); /* 边框：1px半透浅灰色 */
  height:6px; /* 凹槽高度：6px */
  background:palette(window); /* 背景色：系统窗口色 */
  border-radius:3px; /* 圆角：3px */
}

/* 滑动条手柄 */
QSlider::handle:horizontal{
  background:palette(highlight); /* 背景：系统高亮色 */
  width:16px; /* 手柄宽度：16px */
  height:16px; /* 手柄高度：16px */
  margin:-5px 0; /* 上下负边距，让手柄覆盖凹槽 */
  border-radius:8px; /* 全圆角圆形 */
}

/*  SpinBox/DateEdit 等微调框基础样式 */
QAbstractSpinBox {
  border: 1px solid rgba(180,180,180,200); /* 边框：1px半透浅灰色 */
  border-radius:4px; /* 圆角：4px */
  background:palette(base); /* 背景色：系统基础色 */
  padding:2px 4px; /* 内边距：上下2px，左右4px */
}
